{
  "name": "word-format-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Word 论文智慧排版 Agent — monorepo root",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @wfa/api prisma migrate dev",
    "db:studio": "pnpm --filter @wfa/api prisma studio"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12",
    "prettier": "^3.2.5",
    "eslint": "^8.57.0"
  }
}