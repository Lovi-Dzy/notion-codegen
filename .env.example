# 复制此文件为 .env 并填入真实值
# .env 已加入 .gitignore，不会提交到版本控制

# ── Notion ──────────────────────────────────────────────
# 获取方式：https://www.notion.so/my-integrations → 创建集成 → 复制 Internal Integration Secret
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 目标 Notion 页面 ID（可留空，改用 .codegen.toml 或 --page-id 参数）
# 获取方式：打开 Notion 页面 → 复制链接 → URL 中最后一段 32 位字符串即为 ID
NOTION_PAGE_ID=

# ── LLM（notion-codegen 本身不调用 LLM，供 my-llm-client 模块集成使用）──
LLM_PROVIDER=siliconflow
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ── 可选覆盖 ────────────────────────────────────────────
# OUTPUT_DIR=D:\Projects\my-project