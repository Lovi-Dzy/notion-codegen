# 复制此文件为 .env 并填入真实值
# .env 已加入 .gitignore，不会提交到版本控制

# ══════════════════════════════════════════════════════════
#  notion-codegen CLI 配置
# ══════════════════════════════════════════════════════════

# 获取方式：https://www.notion.so/my-integrations → 创建集成 → 复制 Internal Integration Secret
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 目标 Notion 页面 ID（可留空，改用 .codegen.toml 或 CLI 参数）
# 获取方式：打开 Notion 页面 → 复制链接 → URL 中最后一段 32 位字符串即为 ID
NOTION_PAGE_ID=

# 本地输出目录（可留空，改用 .codegen.toml 或 --output 参数）
# OUTPUT_DIR=D:\Projects\my-project

# ── LLM（CLI 后续 AI 功能预留）───────────────────────────
LLM_PROVIDER=siliconflow
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ══════════════════════════════════════════════════════════
#  Word Format Agent (WFA) Web 平台配置
#  以下变量仅在运行 apps/api、apps/worker 时需要
# ══════════════════════════════════════════════════════════

# ── 数据库 ───────────────────────────────────────────────
# DATABASE_URL=postgresql://wfa:wfa_secret@localhost:5432/wfa_dev

# ── Redis ────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── S3 / MinIO 存储 ──────────────────────────────────────
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin123
# S3_BUCKET=wfa
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# ── API 服务 ─────────────────────────────────────────────
# API_PORT=3001
# API_HOST=0.0.0.0
# JWT_SECRET=your-jwt-secret-here
# CORS_ORIGIN=http://localhost:3000

# ── Worker ───────────────────────────────────────────────
# WORKER_CONCURRENCY=4
# PANDOC_PATH=pandoc
# DOCX_WORK_DIR=/tmp/wfa-docx
